# Development proxy target. Copy this file to .env.local and match the Go server.
# Shell environment variables override values from .env files.
STARHUB_API_URL=http://127.0.0.1:3000

# API base URL. Empty by default — the Vite dev server proxies /api
# and /v1 to the Go backend (vite.config.ts), and the release build
# embeds web/dist so browser and API share one origin. Set this only
# when deploying the frontend on a different origin from the API.
VITE_API_BASE_URL=
