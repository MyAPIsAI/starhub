[Unit]
Description=StarHub single-instance gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=starhub
Group=starhub
WorkingDirectory=/var/lib/starhub
EnvironmentFile=/etc/starhub/server.env
ExecStart=/opt/starhub/starhub --config /etc/starhub/config.yml
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=55
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/starhub /var/backups/starhub
UMask=0077

[Install]
WantedBy=multi-user.target
