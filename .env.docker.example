# Docker Compose development defaults. init-deploy.ps1 replaces these secrets
# with new random values when it creates .env.docker.
# Use --env-file .env.docker for every Compose command.
# Keep this file and the SQLite volume together when planning backups/restores.
# These secrets are for local development only; do not use them in production.
STARHUB_ROOT_PASSWORD=Sh1-add462edd05f813ad9306fbd175130a0
STARHUB_CRYPTO_SECRET=131086e93c679949e6d0a679c9b29a222ef99525bf75ae00fe09540ec4ef3030

STARHUB_IMAGE=starhub:local
STARHUB_PLATFORM=linux/amd64
STARHUB_HOST_IP=127.0.0.1
STARHUB_HOST_PORT=3008
STARHUB_COOKIE_SECURE=false
STARHUB_TRUSTED_PROXIES=
STARHUB_ADMIN_IP_WHITELIST=
TZ=Asia/Shanghai
NODE_NAME=starhub-node-1
GOPROXY=https://proxy.golang.org,direct

# Optional versioned wrapping keys; preserve all keys needed by existing data.
STARHUB_CREDENTIAL_KEYS=
STARHUB_CREDENTIAL_ACTIVE_KEY=
STARHUB_REGION_PROFILE=

# Shared by docker-compose.yml and docker-compose.resource.yml.
# Both services use the project default network; -p starhub-test isolates a test pair.
RESOURCE_IMAGE=starhub-resource:latest
RESOURCE_HOST_IP=0.0.0.0
RESOURCE_HOST_PORT=3009
# The host file must exist and contain a JSON array before starting resource.
RESOURCE_COST_FILE=./deploy/resource/cost_resources.json
NEW_API_BASE_URL=http://starhub:3000
RESOURCE_CATALOG_NOTIFY_URL=http://starhub-resource:3001
RESOURCE_CATALOG_NOTIFY_ENABLED=1
# init-deploy.ps1 generates a dedicated token for this pair. Do not reuse the old resource token.
# Store only the raw token here; the resource Compose service adds the Bearer prefix.
METRIC_AUTHORIZATION=
ROUTING_PROTECTION_SOURCE=talen
ROUTING_OBSERVATION_V2_ENABLED=1
