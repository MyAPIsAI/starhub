# Copy to .env.docker and fill the two required secrets, or run init-deploy.ps1.
# Use --env-file .env.docker for every Compose command.
# Keep this file and the SQLite volume together when planning backups/restores.
STARHUB_ROOT_PASSWORD=
STARHUB_CRYPTO_SECRET=

STARHUB_IMAGE=starhub:local
STARHUB_PLATFORM=linux/amd64
STARHUB_HOST_IP=127.0.0.1
STARHUB_HOST_PORT=3008
STARHUB_COOKIE_SECURE=false
STARHUB_TRUSTED_PROXIES=
STARHUB_ADMIN_IP_WHITELIST=
TZ=Asia/Shanghai
NODE_NAME=starhub-node-1
GOPROXY=https://proxy.golang.org,direct

# Optional versioned wrapping keys; preserve all keys needed by existing data.
STARHUB_CREDENTIAL_KEYS=
STARHUB_CREDENTIAL_ACTIVE_KEY=
STARHUB_REGION_PROFILE=

# Used only with docker-compose.resource.yml / build-deploy.ps1 -WithResource.
# Use talen-resource for the sibling resource production Compose project.
RESOURCE_NETWORK_NAME=talen-resource-dev
RESOURCE_CATALOG_NOTIFY_URL=http://resource-backend:3001
RESOURCE_CATALOG_NOTIFY_ENABLED=1
# Share the same token with resource; omit the Bearer prefix on StarHub.
METRIC_AUTHORIZATION=
ROUTING_PROTECTION_SOURCE=talen
ROUTING_OBSERVATION_V2_ENABLED=1
